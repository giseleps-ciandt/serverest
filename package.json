{
  "name": "serverest-cypress-tests",
  "version": "1.0.0",
  "description": "Automated E2E and API tests for ServeRest using Cypress",
  "scripts": {
    "test": "cypress run",
    "cy:run": "node scripts/grep-tags.js",
    "cy:run:frontend": "cypress run --spec 'cypress/e2e/frontend/**/*.cy.js'",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "cy:run:tags": "node scripts/grep-tags.js",
    "cy:open": "cypress open"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  }
}
